# Supabase backend for end-to-end encrypted sync.
# Both values are public/safe to ship — RLS + E2E protect the data.
# Leave both blank to run in legacy local-only mode (no auth, no sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function secrets (set with `supabase secrets set`; never prefix
# these with VITE_ or expose them to the browser):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# ASK_WORTHFOLIO_SIGNING_SECRET=
# ASK_ALLOWED_ORIGINS=https://your-production-origin.example
# ASK_DAILY_REQUEST_LIMIT=60
